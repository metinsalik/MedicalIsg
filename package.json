{
  "name": "medical-isg-monorepo",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev:backend": "pnpm --filter @isg/backend dev",
    "dev:web": "pnpm --filter @isg/web dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "infra:up": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.dev.yml logs -f"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "prettier": "^3.5.3"
  }
}
